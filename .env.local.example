# REAL-001 - local AI service config. Copy to .env.local (gitignored), do NOT commit real keys.
# .env.local overrides .env at next app start (Next.js loads it automatically).
# ASCII-only (no diacritics) so Windows ANSI tools cannot corrupt it.

# --- Hermes llama.cpp router (local OpenAI-compatible endpoint) ---
# base_url is read from %LOCALAPPDATA%\hermes\runtimes\llamacpp\server.json
HERMES_BASE_URL=http://127.0.0.1:18434/v1
# Real model id served by the router (verify with scripts/local/ai-status.ps1):
HERMES_MODEL=Qwen3.8-27B-TurboFCFusion-735-882-Here-Uncen-NEO-CODER-MAX-MTP-Q4_K_S
# Read the real api_key straight from server.json - do NOT paste it here in tracked files:
#   powershell: (Get-Content $env:LOCALAPPDATA\hermes\runtimes\llamacpp\server.json | ConvertFrom-Json).api_key
HERMES_API_KEY=

# --- Optional OpenAI-compatible workers. ONLY fill in when a real service runs ---
# DAI_VISION_BASE_URL=http://127.0.0.1:8001/v1
# DAI_VISION_MODEL=
# DAI_VISION_API_KEY=
# DAI_OCR_BASE_URL=http://127.0.0.1:8002/v1
# DAI_OCR_MODEL=
# DAI_OCR_API_KEY=
# DAI_VOICE_BASE_URL=http://127.0.0.1:8003/v1
# DAI_VOICE_API_KEY=
# DAI_VOICE_STT_MODEL=
# DAI_VOICE_TTS_MODEL=

# --- REAL-002 motion detector (requires ffmpeg on PATH; off by default) ---
# Loop needs DETECT_ENABLED=true here AND detectEnabled=true in Settings UI.
DETECT_ENABLED=true
# DETECT_INTERVAL_MS=5000
# DETECT_MOTION_THRESHOLD=0.008
# DETECT_COOLDOWN_SECONDS=60
