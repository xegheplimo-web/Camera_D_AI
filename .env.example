# Never commit .env. Generate an independent random AUTH_SECRET (32+ chars).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
AUTH_SECRET=
ADMIN_PASSWORD=
OPERATOR_PASSWORD=
VIEWER_PASSWORD=

# Google OAuth 2.0 (authorization-code, server-side). Register GOOGLE_CALLBACK in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK=http://localhost:3000/api/auth/google/callback

# Hermes Agent API server, root or /v1 (profile prefixes are supported).
# Dedicated planner profile: disable all direct tools; Gateway validates /v1/toolsets.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# OpenAI-compatible image workers; models must be explicitly configured.
# Example local worker base: http://127.0.0.1:8001/v1
DAI_VISION_BASE_URL=
DAI_VISION_MODEL=
DAI_VISION_API_KEY=
DAI_OCR_BASE_URL=
DAI_OCR_MODEL=
DAI_OCR_API_KEY=

# OpenAI-compatible audio adapter for your STT/TTS deployment.
# Native faster-whisper / VieNeu are NOT assumed to expose this API themselves.
DAI_VOICE_BASE_URL=
DAI_VOICE_API_KEY=
DAI_VOICE_STT_MODEL=
DAI_VOICE_TTS_MODEL=
DAI_VOICE_NAME=

# Bounded per-upstream request time (1000..20000 ms).
DAI_AI_TIMEOUT_MS=15000

# Optional supervised dispatcher for jobs when no browser is open.
DAI_GATEWAY_URL=http://127.0.0.1:3000
DAI_DISPATCH_TOKEN=

# Camera Gateway (Windows service go2rtc on loopback :1984)
# Required for encrypted IP/RTSP camera profiles. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAMERA_CREDENTIAL_KEY=
GO2RTC_HOST=127.0.0.1

# REAL-002 — server-side motion detector (OFF by default; needs ffmpeg on PATH).
# Loop runs only when DETECT_ENABLED=true AND setting detectEnabled=true (Settings UI).
# DETECT_ENABLED=true
# DETECT_INTERVAL_MS=5000              # >=1000
# DETECT_MOTION_THRESHOLD=0.008        # mean luma diff normalized 0..1 (YAVG/255); 0.008 ≈ 2/255
# DETECT_COOLDOWN_SECONDS=60           # per-camera min gap between events
# DETECT_FFMPEG_BIN=ffmpeg             # override only if ffmpeg not on PATH
# DAI_DATA_DIR=                        # default <repo>/data — detect frames at data/detect/<sha>.jpg

# REAL-003 — retention job (always on; deletes rows older than retentionDays setting).
# Runs once at server start, then every 24h. retentionDays<=0 disables (no-op).
# Per-camera override: cameras.retention_days (PATCH /api/cameras/:id).
# Manual run: POST /api/internal/retention/run with Bearer DAI_DISPATCH_TOKEN.
# RETENTION_INTERVAL_MS=86400000       # >=60000

# T-1305 — demo seed (OFF by default). Fresh installs get demoMode=false and NO
# demo topology (CAM-01..04 cameras, ~1.2k events, assets, extraction mẫu).
# Enable for dev/demo environments only:
# CAMDAI_DEMO_SEED=1
